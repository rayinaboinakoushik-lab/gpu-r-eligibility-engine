# Copy this file to .env and fill in your own values. Never commit .env.
OPENAI_API_KEY=your-openai-key
# Access code the website and API ask for (any long random string)
GPUR_ACCESS_KEY=choose-a-long-random-code
# Optional: where the API keeps session files (default: api_data/)
# GPUR_DATA_DIR=api_data
# Optional: prices in USD per million tokens, for the cost report
# GPUR_PRICE_INPUT=10
# GPUR_PRICE_CACHED=1
# GPUR_PRICE_OUTPUT=50
